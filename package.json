{
	"name": "@arifahmedjoy/leantoken",
	"version": "0.3.0",
	"description": "Token optimizer for AI coding agents: section maps instead of whole-file reads, pruned test/build/git output, and measured savings from real sessions",
	"main": "src/index.js",
	"bin": {
		"lean": "bin/lean.js"
	},
	"files": [
		"bin/",
		"src/",
		"docs/usage.md",
		"README.md",
		"LICENSE",
		"CHANGELOG.md"
	],
	"scripts": {
		"test": "node test/runner.js",
		"benchmark": "node test/benchmark.js",
		"preversion": "npm test",
		"version": "node scripts/changelog.js && git add CHANGELOG.md",
		"prepublishOnly": "npm test && node scripts/changelog.js --check"
	},
	"keywords": [
		"ai",
		"token-optimization",
		"prompt-caching",
		"claude-code",
		"cursor",
		"token-compression"
	],
	"author": "LeanToken Core Team",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/arifahmedjoy/leantoken.git"
	},
	"bugs": {
		"url": "https://github.com/arifahmedjoy/leantoken/issues"
	},
	"homepage": "https://github.com/arifahmedjoy/leantoken#readme",
	"engines": {
		"node": ">=18.0.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
