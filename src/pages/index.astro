---
import "../styles/global.css";
---
<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#f5f7f2">
    <meta name="robots" content="index, follow">
    <meta name="description" content="LeanToken is a local-first CLI for coding agents: initialize supported tools, prune noisy shell output, map source files, and audit real Claude Code sessions.">
    <link rel="canonical" href="https://leantoken.dev/">
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="LeanToken">
    <meta property="og:title" content="LeanToken — Keep coding-agent context lean">
    <meta property="og:description" content="A local-first CLI to initialize coding tools, prune noisy command output, map code, and audit Claude Code sessions.">
    <meta property="og:url" content="https://leantoken.dev/">
    <meta property="og:image" content="https://leantoken.dev/assets/og-image.png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:type" content="image/png">
    <meta property="og:image:alt" content="LeanToken keeps coding-agent context focused with local command pruning and source outlines.">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="LeanToken — Keep coding-agent context lean">
    <meta name="twitter:description" content="A local-first CLI to initialize coding tools, prune noisy command output, map code, and audit Claude Code sessions.">
    <meta name="twitter:image" content="https://leantoken.dev/assets/og-image.png">
    <title>LeanToken — Local CLI for Cleaner Coding-Agent Context</title>
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        "name": "LeanToken",
        "url": "https://leantoken.dev/",
        "description": "A local-first CLI for coding agents: initialize supported tools, prune noisy shell output, map source files, and audit Claude Code sessions.",
        "applicationCategory": "DeveloperApplication",
        "operatingSystem": "Windows, macOS, Linux",
        "softwareVersion": "0.3.1",
        "license": "https://opensource.org/license/mit",
        "codeRepository": "https://github.com/arifahmedjoy/leantoken",
        "programmingLanguage": "JavaScript"
      }
    </script>
    <script defer src="https://context7.com/widget.js" data-library="/arifahmedjoy/leantoken"></script>
  </head>
  <body class="min-h-screen bg-[#f5f7f2] text-[#17241f] antialiased">
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <nav class="nav wrap" aria-label="Main navigation">
        <a class="brand" href="#" aria-label="LeanToken home">
          <span class="brand-mark" aria-hidden="true">
            <svg viewBox="0 0 32 32" fill="none">
              <path d="M7 8.5h11.5a6.5 6.5 0 0 1 0 13H14a4 4 0 0 0 0 8h11" stroke="currentColor" stroke-width="4" stroke-linecap="round"/>
              <circle cx="7" cy="8.5" r="3" fill="currentColor"/>
              <circle cx="25" cy="29.5" r="3" fill="currentColor"/>
            </svg>
          </span>
          <span>lean<span class="brand-light">token</span></span>
        </a>
        <div class="nav-links">
          <a href="#how-it-works">How it works</a>
          <a href="#features">Features</a>
          <a href="#languages">Languages</a>
          <a href="https://docs.leantoken.dev/" target="_blank" rel="noopener noreferrer">
            Docs <span aria-hidden="true">↗</span><span class="sr-only">(opens in a new tab)</span>
          </a>
          <a href="https://context7.com/arifahmedjoy/leantoken" target="_blank" rel="noopener noreferrer">
            Context7 <span aria-hidden="true">↗</span><span class="sr-only">(opens in a new tab)</span>
          </a>
          <a href="https://www.npmjs.com/package/@arifahmedjoy/leantoken" target="_blank" rel="noopener noreferrer">
            npm <span aria-hidden="true">↗</span><span class="sr-only">(opens in a new tab)</span>
          </a>
          <a class="nav-github" href="https://github.com/arifahmedjoy/leantoken" target="_blank" rel="noopener noreferrer">
            GitHub <span aria-hidden="true">↗</span><span class="sr-only">(opens in a new tab)</span>
          </a>
        </div>
      </nav>
    </header>

    <main id="main" tabindex="-1">
      <section class="hero wrap">
        <div class="hero-copy">
          <p class="eyebrow"><span class="pulse-dot"></span> Local-first context tooling</p>
          <h1>Keep your coding agent's context <span>lean.</span></h1>
          <p class="hero-intro">
            Set up supported coding tools, trim noisy command output, map source
            files, and audit real Claude Code sessions. The CLI runs locally,
            with no proxy or model calls.
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href="#get-started">Get started <span aria-hidden="true">→</span></a>
            <a class="button button-quiet" href="https://www.npmjs.com/package/@arifahmedjoy/leantoken" target="_blank" rel="noopener noreferrer">
              npm package <span aria-hidden="true">↗</span><span class="sr-only">(opens in a new tab)</span>
            </a>
            <a class="button button-quiet" href="https://github.com/arifahmedjoy/leantoken" target="_blank" rel="noopener noreferrer">
              Explore the source <span aria-hidden="true">↗</span><span class="sr-only">(opens in a new tab)</span>
            </a>
          </div>
          <div class="hero-facts" aria-label="Project facts">
            <span><i class="fact-check" aria-hidden="true">✓</i> MIT licensed</span>
            <span><i class="fact-check" aria-hidden="true">✓</i> Node.js 18+</span>
            <span><i class="fact-check" aria-hidden="true">✓</i> No runtime dependencies</span>
          </div>
        </div>

        <div class="hero-visual" aria-label="Example of LeanToken summarizing a test command">
          <div class="orbit orbit-one"></div>
          <div class="orbit orbit-two"></div>
          <div class="terminal">
            <div class="terminal-top">
              <div class="window-dots" aria-hidden="true"><i></i><i></i><i></i></div>
              <span>lean — local command view</span>
              <span class="terminal-status"><i></i> ready</span>
            </div>
            <div class="terminal-body">
              <p class="terminal-command"><span>$</span> lean prune npm test</p>
              <div class="terminal-rule"></div>
              <p class="term-muted">Running project test suite...</p>
              <p class="term-success"><span>✓</span> ALL TESTS PASSED</p>
              <p class="term-muted">4 test groups completed</p>
              <div class="terminal-rule terminal-rule-short"></div>
              <p class="term-output">[LeanToken: condensed output]</p>
              <p class="term-path"><span>↳</span> Full output: .lean/logs/&lt;time&gt;-&lt;command&gt;.log</p>
            </div>
            <div class="terminal-foot">
              <span><b></b> Pruned output saved locally</span>
              <span>0 CLI network calls</span>
            </div>
          </div>
          <div class="visual-note note-top"><span class="note-icon">↘</span> noisy output</div>
          <div class="visual-note note-bottom"><span class="note-icon">✳</span> useful signal</div>
          <div class="hero-spark spark-one" aria-hidden="true">✳</div>
          <div class="hero-spark spark-two" aria-hidden="true">·</div>
        </div>
      </section>

      <section class="trust-strip" aria-label="LeanToken summary">
        <div class="wrap trust-items">
          <span class="trust-label">BUILT FOR PRACTICAL CODING WORKFLOWS</span>
          <span><b>01</b> deterministic pruning</span>
          <span><b>02</b> lightweight outlines</span>
          <span><b>03</b> local project memory</span>
        </div>
      </section>

      <section class="section wrap">
        <div class="section-heading">
          <p class="eyebrow">A smaller loop, not another layer</p>
          <h2 id="how-it-works" tabindex="-1">Useful context in.<br><span>Less noise out.</span></h2>
          <p>LeanToken works at the edges of your coding workflow. It doesn't sit between your agent and its model.</p>
        </div>
        <div class="flow-card">
          <div class="flow-topline"><span>THE LOCAL FLOW</span><span class="flow-id">01 / 03</span></div>
          <div class="flow-diagram">
            <div class="flow-node">
              <span class="flow-icon icon-command" aria-hidden="true">&gt;_</span>
              <strong>Your command</strong>
              <small>git · tests · JSON · more</small>
            </div>
            <span class="flow-arrow" aria-hidden="true">→</span>
            <div class="flow-node flow-node-active">
              <span class="flow-icon icon-lean" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none"><path d="M5 6h14M8 12h8m-5 6h2" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
              </span>
              <strong>LeanToken</strong>
              <small>deterministic local rules</small>
            </div>
            <span class="flow-arrow" aria-hidden="true">→</span>
            <div class="flow-node">
              <span class="flow-icon icon-context" aria-hidden="true">✳</span>
              <strong>Focused context</strong>
              <small>agent sees the signal</small>
            </div>
          </div>
          <div class="flow-foot">
            <span class="flow-lock" aria-hidden="true">⌑</span>
            <p><strong>Full output stays close.</strong> When output is actually pruned, the original is best-effort saved to your local <code>.lean/logs/</code> folder.</p>
            <span class="local-pill">LOCAL</span>
          </div>
        </div>
      </section>

      <section class="features-section">
        <div class="wrap">
          <div class="section-heading section-heading-center">
            <p class="eyebrow">Small tools. Clear jobs.</p>
            <h2 id="features" tabindex="-1">Keep the useful.<br><span>Leave the rest nearby.</span></h2>
            <p>Independent CLI features you can use together or one at a time.</p>
          </div>
          <div class="feature-grid">
            <article class="feature-card feature-card-dark">
              <div class="feature-icon feature-icon-green" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none"><path d="M4 5h16M7 10h10m-7 5h4m-2 4h0" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
              </div>
              <p class="feature-index">01 / OUTPUT</p>
              <h3>Prune command noise</h3>
              <p>Condense common Git, test, directory, and JSON output with predictable local rules. Unexpected parsing trouble fails open to the original output.</p>
              <code class="feature-code">lean prune git status</code>
              <div class="card-glow" aria-hidden="true"></div>
            </article>
            <article class="feature-card">
              <div class="feature-icon feature-icon-violet" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none"><path d="M8 4H5v16h3m8-16h3v16h-3M14 7l-4 10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </div>
              <p class="feature-index">02 / STRUCTURE</p>
              <h3>See code shape</h3>
              <p>Get lightweight source signatures or Markdown section maps with line ranges, so you can read only the parts you need.</p>
              <code class="feature-code">lean symbols src/</code>
            </article>
            <article class="feature-card">
              <div class="feature-icon feature-icon-amber" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none"><path d="M12 3v3m0 12v3M4.6 4.6l2.1 2.1m10.6 10.6 2.1 2.1M3 12h3m12 0h3M4.6 19.4l2.1-2.1M17.3 6.7l2.1-2.1M9 10a3 3 0 1 1 5.2 2c-.9.8-2.2 1.1-2.2 2.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
              </div>
              <p class="feature-index">03 / LEARNING</p>
              <h3>Remember project patterns</h3>
              <p>Analyze recent Claude Code sessions to map frequently read files and recurring command errors into local project memory.</p>
              <code class="feature-code">lean learn session.jsonl</code>
            </article>
            <article class="feature-card">
              <div class="feature-icon feature-icon-blue" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none"><path d="M5 18V9m7 9V5m7 13v-6M3 20h18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
              </div>
              <p class="feature-index">04 / MEASUREMENT</p>
              <h3>Audit real sessions</h3>
              <p>See model token counts, shell output pruned or skipped, repeated reads, and the files your Claude Code sessions use most.</p>
              <code class="feature-code">lean audit</code>
            </article>
            <article class="feature-card feature-card-wide">
              <div class="wide-copy">
                <div class="feature-icon feature-icon-green" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none"><path d="M12 3 4 7v5c0 4.6 3.4 7.8 8 9 4.6-1.2 8-4.4 8-9V7l-8-4Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="m9 12 2 2 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </div>
                <p class="feature-index">LOCAL BY DESIGN</p>
                <h3>Your workflow stays yours.</h3>
                <p>LeanToken sets up local instructions for supported coding tools and, when Claude Code is detected, its output-pruning hook. It does not proxy or rewrite model conversations.</p>
              </div>
              <div class="privacy-visual" aria-hidden="true">
                <span class="privacy-ring ring-one"></span>
                <span class="privacy-ring ring-two"></span>
                <span class="privacy-core">LT</span>
                <span class="privacy-label">YOUR MACHINE</span>
              </div>
            </article>
          </div>
        </div>
      </section>

      <section class="section languages-section wrap">
        <div class="language-copy">
          <p class="eyebrow">Language-friendly, not language-bound</p>
          <h2 id="languages" tabindex="-1">Work in the stack<br><span>you already have.</span></h2>
          <p>Command pruning is language-agnostic. Symbol outlines cover 12 common source languages, Markdown section maps, and a generic summary for other files.</p>
          <a class="text-link" href="https://github.com/arifahmedjoy/leantoken/blob/main/docs/usage.md" target="_blank" rel="noopener noreferrer">
            See usage details <span aria-hidden="true">↗</span><span class="sr-only">(opens in a new tab)</span>
          </a>
        </div>
        <div class="language-panel">
          <div class="language-panel-top"><span>OUTLINE SUPPORT</span><span class="language-live"><i></i> 12 languages</span></div>
          <div class="language-list" aria-label="Source languages with lightweight outline support">
            <span>JavaScript</span><span>TypeScript</span><span>Python</span>
            <span>PHP</span><span>Java</span><span>C#</span>
            <span>Go</span><span>Rust</span><span>Ruby</span>
            <span>Kotlin</span><span>Swift</span><span>C / C++</span>
          </div>
          <p class="language-note"><span aria-hidden="true">↳</span> Best-effort, lightweight outlines — not compiler-grade parsing.</p>
        </div>
      </section>

      <section class="start-section">
        <div class="wrap start-wrap">
          <div>
            <p class="eyebrow eyebrow-light">v0.3.1 · Open source · MIT · Node.js 18+</p>
            <h2 id="get-started" tabindex="-1">Make room for<br><span>the real work.</span></h2>
            <p>Install LeanToken from npm, then initialize the coding tools detected for your project. Preview the changes first if you like.</p>
          </div>
          <div class="start-code">
            <div class="start-code-top"><span>QUICK START</span></div>
            <pre><code>npm install -g @arifahmedjoy/leantoken
cd your-project
lean init --dry-run
lean init
lean doctor</code></pre>
            <a href="https://github.com/arifahmedjoy/leantoken" target="_blank" rel="noopener noreferrer">
              Browse the repository <span aria-hidden="true">↗</span><span class="sr-only">(opens in a new tab)</span>
            </a>
            <a href="https://www.npmjs.com/package/@arifahmedjoy/leantoken" target="_blank" rel="noopener noreferrer">
              View the npm package <span aria-hidden="true">↗</span><span class="sr-only">(opens in a new tab)</span>
            </a>
            <a href="https://docs.leantoken.dev/" target="_blank" rel="noopener noreferrer">
              Read the documentation <span aria-hidden="true">↗</span><span class="sr-only">(opens in a new tab)</span>
            </a>
            <a href="https://context7.com/arifahmedjoy/leantoken" target="_blank" rel="noopener noreferrer">
              Find LeanToken on Context7 <span aria-hidden="true">↗</span><span class="sr-only">(opens in a new tab)</span>
            </a>
          </div>
        </div>
      </section>

      <section class="faq-section wrap" id="faq">
        <div class="faq-intro">
          <p class="eyebrow">A few quick answers</p>
          <h2>Good to know.</h2>
          <p>LeanToken is intentionally small. Here’s what that means in practice.</p>
        </div>
        <div class="faq-list">
          <details>
            <summary>Does LeanToken send code or prompts to a service?</summary>
            <p>No. The CLI does not send source code, command output, or prompts to a LeanToken service. The documentation chat on this website is a separate Context7 widget, not part of the CLI.</p>
          </details>
          <details>
            <summary>Does it require a specific coding agent?</summary>
            <p>No. LeanToken can write instructions for supported coding tools. Its automatic shell-output pruning hook is for Claude Code; you can also run the CLI commands directly.</p>
          </details>
          <details>
            <summary>Does symbol outlining parse every language perfectly?</summary>
            <p>No. It uses lightweight heuristics for supported source languages, provides section maps for Markdown, and a generic summary for other individual files. It is for quick orientation, not a replacement for a compiler or language server.</p>
          </details>
          <details>
            <summary>What happens to the full command output?</summary>
            <p>When output is actually pruned, the raw output is best-effort saved to <code>.lean/logs/</code> in a per-run file. LeanToken keeps the 20 newest logs.</p>
          </details>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="wrap footer-main">
        <a class="brand footer-brand" href="#" aria-label="LeanToken home">
          <span class="brand-mark" aria-hidden="true">
            <svg viewBox="0 0 32 32" fill="none">
              <path d="M7 8.5h11.5a6.5 6.5 0 0 1 0 13H14a4 4 0 0 0 0 8h11" stroke="currentColor" stroke-width="4" stroke-linecap="round"/>
              <circle cx="7" cy="8.5" r="3" fill="currentColor"/>
              <circle cx="25" cy="29.5" r="3" fill="currentColor"/>
            </svg>
          </span>
          <span>lean<span class="brand-light">token</span></span>
        </a>
        <p>Less noise. More signal. Locally.</p>
        <div class="footer-links">
          <a href="https://github.com/arifahmedjoy/leantoken" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span><span class="sr-only">(opens in a new tab)</span></a>
          <a href="https://github.com/arifahmedjoy/leantoken/blob/main/LICENSE" target="_blank" rel="noopener noreferrer">MIT License <span aria-hidden="true">↗</span><span class="sr-only">(opens in a new tab)</span></a>
          <a href="https://github.com/arifahmedjoy/leantoken/blob/main/SECURITY.md" target="_blank" rel="noopener noreferrer">Security <span aria-hidden="true">↗</span><span class="sr-only">(opens in a new tab)</span></a>
          <a href="https://www.npmjs.com/package/@arifahmedjoy/leantoken" target="_blank" rel="noopener noreferrer">npm <span aria-hidden="true">↗</span><span class="sr-only">(opens in a new tab)</span></a>
          <a href="https://docs.leantoken.dev/" target="_blank" rel="noopener noreferrer">Docs <span aria-hidden="true">↗</span><span class="sr-only">(opens in a new tab)</span></a>
          <a href="https://context7.com/arifahmedjoy/leantoken" target="_blank" rel="noopener noreferrer">Context7 <span aria-hidden="true">↗</span><span class="sr-only">(opens in a new tab)</span></a>
        </div>
      </div>
      <div class="wrap footer-bottom">
        <span>© 2026 LeanToken contributors</span>
        <span>Made for people building with code.</span>
      </div>
    </footer>
  </body>
</html>
